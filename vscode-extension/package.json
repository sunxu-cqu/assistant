{
  "name": "resume-assistant",
  "displayName": "简历助手",
  "description": "定向投递：从本地项目资料里检索对口经历，生成每条都能溯源的简历",
  "version": "0.1.0",
  "publisher": "sunxu",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "resume",
    "简历",
    "投递",
    "保研",
    "mcp"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onView:resumeAssistant.board"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "resumeAssistant",
          "title": "简历助手",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "resumeAssistant": [
        {
          "type": "webview",
          "id": "resumeAssistant.board",
          "name": "投递看板"
        }
      ]
    },
    "commands": [
      {
        "command": "resumeAssistant.openBoard",
        "title": "打开完整看板",
        "category": "简历助手"
      },
      {
        "command": "resumeAssistant.refresh",
        "title": "刷新",
        "category": "简历助手",
        "icon": "$(refresh)"
      },
      {
        "command": "resumeAssistant.doctor",
        "title": "环境自检",
        "category": "简历助手"
      },
      {
        "command": "resumeAssistant.revealData",
        "title": "打开数据目录",
        "category": "简历助手"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "resumeAssistant.refresh",
          "when": "view == resumeAssistant.board",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "简历助手",
      "properties": {
        "resumeAssistant.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Python 解释器路径。留空则依次找工作区下的 `.venv/Scripts/python.exe`（Windows）或 `.venv/bin/python`，再退到 PATH 里的 `python`。"
        },
        "resumeAssistant.projectPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "`resume_assistant` 包所在目录（含 `data/` 和 `workspace/`）。留空则用当前工作区根目录。"
        },
        "resumeAssistant.autoRefreshSeconds": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "自动刷新间隔（秒），0 表示关闭。简历资料是本地的，刷新很便宜，但生成简历时别自动刷新。"
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {}
}
