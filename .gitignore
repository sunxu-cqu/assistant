# Python
.venv/
__pycache__/
*.pyc
*.pyo

# 密钥与个人信息（绝不入库）
.env
data/profile.yaml

# 运行时产物
data/resume.db
data/applications/*
!data/applications/.gitkeep
data/evidence/*
!data/evidence/.gitkeep
data/jobs/*
!data/jobs/.gitkeep

# 输出目录：只保留模板预览 PDF，其余忽略
data/output/*
!data/output/_preview/
data/output/_preview/*.png

# 通用忽略
*.pdf
!data/output/_preview/**/*.pdf
!tests/sandbox/workspace/**/*.pdf
.DS_Store
Thumbs.db
.idea/
.vscode/

# 端到端测试的运行时产物（fixture 资料本身要提交，保证可复现）
tests/sandbox/data/
tests/sandbox/*.log
tests/sandbox/*.png

# 字号自适应对比试排产物
tests/sandbox/fit_*/
tests/sandbox/_fit/

# 知识库校对卡片页
data/review.html
# 冒烟测试的沙箱数据（每次重跑重建）
tests/sandbox/smoke/

# 投递看板页
data/board.html

# 看板演示用沙箱
tests/sandbox/boardtest/

# 边界测试与临时排查用的沙箱
tests/sandbox/edge/
tests/sandbox/badyaml/
tests/sandbox/noedu/
tests/sandbox/*.txt
