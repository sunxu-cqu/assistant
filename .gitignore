# Python
.venv/
__pycache__/
*.pyc
*.pyo

# 密钥与个人信息（绝不入库）
.env
data/profile.yaml

# 运行时产物
data/resume.db
data/applications/*
!data/applications/.gitkeep
data/evidence/*
!data/evidence/.gitkeep
data/jobs/*
!data/jobs/.gitkeep

# 输出目录：只保留模板预览 PDF，其余忽略
data/output/*
!data/output/_preview/
data/output/_preview/*.png

# 通用忽略
*.pdf
!data/output/_preview/**/*.pdf
.DS_Store
Thumbs.db
.idea/
.vscode/

# 知识库校对卡片页 / 投递看板页
data/review.html
data/board.html

# 测试沙箱：只提交 fixture 资料（tests/sandbox/workspace/），其余全是每次重跑重建的产物
tests/sandbox/*
!tests/sandbox/workspace/
!tests/sandbox/workspace/**/*.pdf

# 扩展打包产物（可重建：npm run package）
*.vsix
